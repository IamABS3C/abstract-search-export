{
  "name": "okta-failures-not-service-accounts",
  "mode": "simple",
  "dataset": "Okta",
  "filters": [
    {"field": "event.outcome", "op": "IS_IN_LIST", "type": "String", "value": "failure"},
    {"field": "user_name", "op": "DOES_NOT_START_WITH", "type": "String", "value": "svc-", "or_empty": true}
  ],
  "any_groups": [
    [
      {"field": "action", "op": "CONTAINS", "type": "String", "value": "authentication"},
      {"field": "action", "op": "CONTAINS", "type": "String", "value": "mfa"}
    ]
  ],
  "time": {"last": "24h"},
  "fields": ["@timestamp", "id", "user_name", "action", "event.outcome", "source_ipv4", "data_stream.dataset"],
  "full_documents": false,
  "format": "ndjson.gz"
}
