{
  "mcpServers": {
    "abstract-search": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "search-export/abstract_search.py",
        "mcp"
      ],
      "env": {
        "ABSTRACT_VENDOR_ACCOUNT_ID": "${ABSTRACT_VENDOR_ACCOUNT_ID:-}",
        "ABSTRACT_API_KEY_COMMAND": "${ABSTRACT_API_KEY_COMMAND:-}",
        "ABSTRACT_API_KEY_FILE": "${ABSTRACT_API_KEY_FILE:-}",
        "ABSTRACT_API_KEY_FROM_NETWORK": "${ABSTRACT_API_KEY_FROM_NETWORK:-}",
        "ABSTRACT_API_KEY": "${ABSTRACT_API_KEY:-}",
        "ABSTRACT_BASE_URL": "${ABSTRACT_BASE_URL:-https://api.abstractsecurity.app}"
      }
    }
  }
}
